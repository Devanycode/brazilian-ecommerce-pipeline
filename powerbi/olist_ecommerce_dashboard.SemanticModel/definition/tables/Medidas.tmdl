table Medidas
	lineageTag: 4c821511-edcb-44d3-a379-703a241d0629

	measure 'ventas totales' = SUM('brazilian_ecommerce tabla_analitica'[price])
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: 432714ea-513b-4e20-ae6b-e064098dcecd

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Pedidos Totales' = DISTINCTCOUNT('brazilian_ecommerce tabla_analitica'[order_id])
		formatString: #,0
		lineageTag: 390b8ca2-0930-4c40-9cf1-94ab0cb35d1a

	measure 'Ticket Promedio' = ```
			[ventas totales] / [Pedidos Totales] 
			```
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: bc384121-d172-4782-9496-542ae1ff4d9d

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Tiempo Promedio de Entrega' =
			AVERAGEX(
			    DISTINCT('brazilian_ecommerce tabla_analitica'[order_id]),
			    CALCULATE(AVERAGE('brazilian_ecommerce tabla_analitica'[dias_entrega]))
			    )
		lineageTag: ad5a4189-74ed-47b3-90cd-9e17731d2bd5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Satisfaccion Promedio' =
			AVERAGEX(
			                            DISTINCT('brazilian_ecommerce tabla_analitica'[order_id]),
			                            CALCULATE(AVERAGE('brazilian_ecommerce tabla_analitica'[review_score_promedio]))
			                                )
		lineageTag: 3bfc4356-ab31-4abf-b981-df8f8fa43e25

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'total entregas a tiempo' = ```
			CALCULATE(
			    DISTINCTCOUNT('brazilian_ecommerce tabla_analitica'[order_id]),
			    'brazilian_ecommerce tabla_analitica'[Cumplimiento Entrega] = "mismo dia" || 
			    'brazilian_ecommerce tabla_analitica'[Cumplimiento Entrega] = "antes de tiempo"
			)
			```
		formatString: 0
		lineageTag: 5e5bb72a-06ee-42f2-8213-a58991927a57

	measure 'conteo pedidos entregados' =
			CALCULATE(
			    DISTINCTCOUNT('brazilian_ecommerce tabla_analitica'[order_id]),
			    'brazilian_ecommerce tabla_analitica'[Cumplimiento Entrega] <> "sin fecha de entrega"
			)
		lineageTag: b0a1b057-d8ad-41c9-aa1e-dd2658c042cf

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'porcentaje de entregas a tiempo' = DIVIDE([total entregas a tiempo], [conteo pedidos entregados], 0)
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: f28c5b66-865e-42d7-b0e5-0c4aff411ebb

	measure 'Objetivo entrega' = 0.90
		lineageTag: 36684732-e531-43ce-96f0-77fe40ba0f91

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Cantidad Items' = COUNT('brazilian_ecommerce tabla_analitica'[order_item_id])
		formatString: 0
		lineageTag: db3106e6-e330-4880-899e-dc449a8a58db

	measure 'Etiquetas Top 10' = ```
			
			IF(
			    RANKX(ALL('brazilian_ecommerce tabla_analitica'[product_category_name]), [Ventas Totales], , DESC) <= 10,
			    SELECTEDVALUE('brazilian_ecommerce tabla_analitica'[product_category_name]),
			    BLANK()
			)
			
			```
		lineageTag: ce5e5cd6-1a70-4453-bf20-aac903a6428e

	column Columna1
		dataType: string
		lineageTag: 0e8d400d-a50f-4154-b6af-eb180056bbd1
		summarizeBy: none
		sourceColumn: Columna1

		annotation SummarizationSetBy = Automatic

	partition Medidas = m
		mode: import
		source =
				let
				    Origen = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i45WqlCKjQUA", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Columna1 = _t]),
				    #"Tipo cambiado" = Table.TransformColumnTypes(Origen,{{"Columna1", type text}})
				in
				    #"Tipo cambiado"

	annotation PBI_ResultType = Table

