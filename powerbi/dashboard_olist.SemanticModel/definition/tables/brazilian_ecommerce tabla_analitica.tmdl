	column 'Dias Entrega' = DATEDIFF([order_purchase_timestamp], [order_delivered_customer_date], DAY)
		formatString: 0
		lineageTag: cbce2559-a14f-487f-bab6-ec1db8b9e186
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Cumplimiento Entrega' = ```
			
			        SWITCH(
			            TRUE(),
			            ISBLANK([order_estimated_delivery_date]) || ISBLANK([order_delivered_customer_date]), "sin fecha de entrega",
			            DATEDIFF([order_estimated_delivery_date], [order_delivered_customer_date], DAY) > 0, "despues de tiempo",
			            DATEDIFF([order_estimated_delivery_date], [order_delivered_customer_date], DAY) = 0, "mismo dia",
			            "antes de tiempo"
			        )
			```
		lineageTag: 79b9e756-1f58-45d9-befb-a9836ffbe8da
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition 'brazilian_ecommerce tabla_analitica' = m
